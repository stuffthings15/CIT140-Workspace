          <mxGeometry x="1620" y="270" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="dr2" value="Drainage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1620" y="440" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="st2" value="Structures" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
