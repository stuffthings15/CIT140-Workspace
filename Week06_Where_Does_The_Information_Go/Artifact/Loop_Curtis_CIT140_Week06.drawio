        <mxCell id="n1" value="OUTSIDE THE BOUNDARY (W06-S01)&#10;Flight control, physical inspections, repair work, and routing-table maintenance by the service administrator." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="n2" value="BALANCING&#10;The external flows on this page are the same four flow types shown on page 2: inspection report in, validation note out, and work items out to the three departments." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
